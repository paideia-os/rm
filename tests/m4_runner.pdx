// tests/m4_runner.pdx -- rm.M4 corpus runner
// M4Runner module: aggregates the four M4Test00X entry points into
// one deterministic run.
//
// Scope
// -----
// A single public entry, `m4_run_all`, invokes each of the four
// M4-00X tests in issue-number order:
//
//   run_m4_001 -- TXN-abort mid-remove: no files removed
//   run_m4_002 -- undo within retention window succeeds
//   run_m4_003 -- undo after retention window: ENOENT-with-diagnostic
//   run_m4_004 -- --wipe audit flag correctness (forensic detection)
//
// Each test prints its own `[rm.M4-XXX OK]` or `[rm.M4-XXX FAIL]`
// fingerprint on stdout before returning. The runner prints a
// prologue line before dispatch, an epilogue line after, and returns
// 0 if every test returned 0, 1 otherwise. The runner does NOT
// short-circuit on first failure -- every test runs so a maintainer
// gets the full failure matrix from one execution.
//
// Invocation shape
// ----------------
// Not wired into rm's manifest.pdxproj at M4 (see tests/README.md
// §Build note). The M5 substrate integration commit lands the
// `rm-tests` build target with `M4Runner::m4_run_all` as its
// entry symbol so the smoke driver can invoke the corpus directly;
// until then this module is source-only and its output shape is
// documented in tests/expected-m4-fingerprints.txt.
//
// Fingerprint corpus emitted (in order)
// -------------------------------------
//   [rm.M4-runner]
//   [rm.M4-001 OK]      (or FAIL)
//   [rm.M4-002 OK]      (or FAIL)
//   [rm.M4-003 OK]      (or FAIL)
//   [rm.M4-004 OK]      (or FAIL)
//   [rm.M4-runner done]
//
// The prologue + epilogue markers let the smoke driver bracket the
// run and detect a crash-in-progress (no [done] line means at least
// one test crashed the runner). Substring matching is grep-style
// per the paideia-os tools/run-smoke.sh convention.
//
// paideia-as compliance
// ---------------------
//   - Module M4Runner (PascalCase basename).
//   - No test mnemonic; every zero-check via cmp reg, 0.
//   - Every cmp reg, imm <= 0x7FFFFFFF (only 0 appears).
//   - r11 is scratch (every .rodata lea).
//   - No byte reads (all qword-wide OR of return codes).
//   - m4_run_all prologue: 1-push (rbx) preserves the accumulator
//     across four nested test calls + two nested print_str calls.
//     Entry rsp % 16 == 8; push brings it to 0 which satisfies the
//     alignment invariant for every callee.

module M4Runner = structure {

  // -- Prologue + epilogue fingerprints --------------------------------
  //
  // [rm.M4-runner]\n           = 15 bytes
  // [rm.M4-runner done]\n      = 20 bytes
  pub let RUNNER_PROLOGUE     : [u8; 15] = "[rm.M4-runner]\n"
  pub let RUNNER_PROLOGUE_LEN : u64      = 15

  pub let RUNNER_EPILOGUE     : [u8; 20] = "[rm.M4-runner done]\n"
  pub let RUNNER_EPILOGUE_LEN : u64      = 20

  // ============================================================================
  // m4_run_all() -> u64
  //
  // Signature: m4_run_all : () -> u64 !{mem, sysreg} @{cap, sched}
  // RAX (output): 0 if every test returned 0; 1 if any returned non-0.
  //
  // Body:
  //   (1) print RUNNER_PROLOGUE.
  //   (2) run each M4Test0XX::run_m4_00X in order; OR each return
  //       code into an accumulator (rbx).
  //   (3) print RUNNER_EPILOGUE.
  //   (4) return the accumulator (0 = all pass, 1 = any fail).
  //
  // Register plan (1-push prologue + no pad; every nested call at
  // aligned rsp):
  //   push rbx     -- rsp%16: 8 -> 0
  //   rbx = OR-accumulator of test return codes
  //   rax = call return / print scratch
  //   rdi = print buf
  //   rsi = print len
  //   r11 = lea scratch (.rodata reads)
  //
  // Every test's declared effect tail is a subset of the runner's
  // !{mem, sysreg} @{cap, sched}; the runner's tail is set to cover
  // the strictest of the four (M4Test001 / M4Test004 both declare
  // @{cap, sched}) so a single tail suffices at the runner boundary.
  // ============================================================================
  pub let m4_run_all : () -> u64 !{mem, sysreg} @{cap, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap, sched},
      justification: "rm.M4 runner. Prints [rm.M4-runner] prologue, invokes M4Test001::run_m4_001 through M4Test004::run_m4_004 in issue-number order, ORs each return code into rbx (0 for all-OK, 1 for any-fail), prints [rm.M4-runner done] epilogue, and returns rbx. Every test runs unconditionally -- a first-failure short-circuit would deprive the maintainer of the full failure matrix from one execution. 1-push prologue (rbx) preserves the accumulator across the six nested calls (two Print + four test runners); every callee uses SysV callee-save on rbx. Entry rsp%16 == 8, push brings it to 0 which satisfies alignment for every callee. r11 scratch only for the two lea + print sequences; the four test calls take no arguments and produce no register conflict. All immediates 0 or the two byte-lengths 15, 20 (fit imm32). Effect tail !{mem, sysreg} @{cap, sched} matches the strictest of the four tests (M4Test001 / M4Test004 declare @{cap, sched} via their rm_process_one calls).",
      block: {
        push rbx;                                // rsp%16: 8 -> 0
        xor rbx, rbx;                            // accumulator = 0

        // (1) Prologue fingerprint.
        lea rdi, [rip + RUNNER_PROLOGUE];
        mov rsi, 15;                             // RUNNER_PROLOGUE_LEN
        call print_str;

        // (2) Run each test; OR return code into rbx.
        call run_m4_001;
        or rbx, rax;

        call run_m4_002;
        or rbx, rax;

        call run_m4_003;
        or rbx, rax;

        call run_m4_004;
        or rbx, rax;

        // (3) Epilogue fingerprint.
        lea rdi, [rip + RUNNER_EPILOGUE];
        mov rsi, 20;                             // RUNNER_EPILOGUE_LEN
        call print_str;

        // (4) Return accumulator.
        mov rax, rbx;
        pop rbx;
        ret;
      }
    }
}
