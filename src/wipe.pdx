// src/wipe.pdx — rm.M2-004
// RmWipe module: --wipe (shred) — immediate trash-entry unlink +
// best-effort byte overwrite; sets a per-invocation audit flag so
// the M3-002 forensic reader can detect intentional shred.
//
// Scope
// -----
// This module implements the M2-004 scope (paideia-os design/tooling/
// r49-r50-plan.md §5.8 M2-004 + §4.8 "rm --wipe" semantics from
// design/user/model.md §7.1). Unlike a default rm which moves the
// target into the trash subtree and leaves it there for the 24h
// retention window (M2-003), a --wipe rm:
//
//   * skips the trash-subtree entry entirely (no retention applies —
//     the target vanishes from the FS instantly);
//   * best-effort byte-overwrites the underlying storage (BLKSECDISC
//     on devices that support it, plain overwrite otherwise);
//   * sets an audit flag on the M3 RemoveRecord so a forensic reader
//     can distinguish "user ran rm and the entry was later reaped"
//     from "user ran rm --wipe (intentional shred)".
//
// The audit-flag mechanism at M2 lives here as a `.bss` boolean
// (was_wiped_flag). rm.M3-002 wires the flag into the RemoveRecord
// payload via libpdx-audit; at that point the M2 read from this
// slot becomes the audit-record field value. At M2 the flag is the
// primary observability signal for the M4-004 test invariant ("--wipe
// audit flag correctness (forensic reader can detect intentional
// shred)"): the M4 smoke matrix reads the flag after a --wipe
// invocation and asserts it is 1.
//
// The M2 wipe body does NOT actually shred anything — the mutating
// PdxFS ops (sys_pdxfs_unlink, sys_pdxfs_secdisc) are R42 substrate
// work not in-tree. The skeleton emits a per-target four-part line:
//
//   (optional "rm: ") + "shred: " + <target> + ": (M2 stub —
//   immediate trash-unlink + best-effort byte overwrite)\n"
//
// plus sets was_wiped_flag = 1 and bumps wipe_count. Same "faithfully
// emit the shape of the substrate call without inventing an outcome"
// discipline as the mv.M1-003 and cp.M1-003 skeletons.
//
// Interaction with the other M2 branches
// --------------------------------------
// `rm_process_one` dispatches on `flag_wipe` before falling through
// to the default M2 shape. Priority order (per design/argv-surface.md
// §3.2 combining semantics):
//
//   1. `--dry-run` beats `--wipe`: dry-run always emits "would
//      remove: <target>\n" and takes no real-side-effect path.
//   2. `--wipe` beats the default retention path: shred creates no
//      trash entry, so `RmRetention::retention_attach` is not called
//      and no `RETENTION_NOTE` is emitted.
//   3. Under `-r` at post-M2 substrate landing, the recursive walk
//      threads wipe per-leaf. At M2 the walk branch does not
//      short-circuit on wipe (the walk skeleton emits a single line
//      per top-level target regardless); the wipe-in-walk case is
//      an M2 → substrate transition addendum.
//
// The `confirm_check` call at M2-002 runs BEFORE the wipe dispatch
// — --wipe under -f is skip-granted at M2, and --wipe without -f
// bumps `confirm_prompts_stub` (M3 will require the elevate hop for
// wipe even inside the invoker's home subtree per M3-004).
//
// paideia-as compliance
// ---------------------
//   - Module RmWipe (PascalCase basename).
//   - No test mnemonic; every zero-check via cmp reg, 0.
//   - Every cmp reg, imm ≤ 0x7FFFFFFF (only 0 and single-byte char
//     codes appear here).
//   - r11 is scratch (used for every lea to .rodata + .bss).
//   - Byte reads via xor rax, rax; mov_b rax, [ptr] (#1248 mitigation)
//     inside the NUL-walk for target-length compute.
//   - wipe_emit prologue: 1-push (rbx) preserves target_ptr across
//     up-to-four nested Print::print_str calls. Entry rsp % 16 == 8;
//     push brings it to 0 which satisfies syscall alignment.

module RmWipe = structure {

  // -- .bss slots -------------------------------------------------------
  //
  // was_wiped_flag — set to 1 on the first --wipe emit of the rm
  // invocation, never cleared during the invocation. The M3-002 audit
  // hook reads this slot after all positionals are processed and
  // stamps it onto the RemoveRecord as the `was_wiped` boolean
  // field. Reset each invocation via RmRemove::remove_reset.
  //
  // wipe_count — bumped once per wipe_emit call. Divergence between
  // wipe_count and removed_count is the M4-detected signal that a
  // subset of the positionals took the --wipe branch (e.g. some
  // targets were dirs handled by the walk skeleton without wipe).
  pub let mut was_wiped_flag : u64 = uninit @align(8)
  pub let mut wipe_count     : u64 = uninit @align(8)

  // -- .rodata output pieces --------------------------------------------
  //
  // Mirror of RmRemove::VERBOSE_PREFIX so this module needs no cross-
  // module dep on RmRemove for the verbose emit. 4 bytes: 'r' 'm' ':' ' '.
  pub let VERBOSE_PREFIX     : [u8; 4]  = "rm: "
  pub let VERBOSE_PREFIX_LEN : u64      = 4

  // "shred: " — 7 bytes.
  pub let WIPE_PREFIX        : [u8; 7]  = "shred: "
  pub let WIPE_PREFIX_LEN    : u64      = 7

  // M2-scope stub suffix for the wipe branch. 67 bytes:
  // ": (M2 stub -- immediate trash-unlink + best-effort byte overwrite)\n".
  pub let WIPE_STUB_SUFFIX     : [u8; 67] =
    ": (M2 stub -- immediate trash-unlink + best-effort byte overwrite)\n"
  pub let WIPE_STUB_SUFFIX_LEN : u64      = 67

  // ============================================================================
  // wipe_emit(target_ptr) -> ()
  //
  // Signature: wipe_emit : (u64) -> () !{mem, sysreg} @{}
  // RDI (input): target_ptr — NUL-terminated path pointer.
  //
  // M2-004 body:
  //   (1) set was_wiped_flag = 1;
  //   (2) bump wipe_count;
  //   (3) if flag_v == 1: emit VERBOSE_PREFIX "rm: ";
  //   (4) emit WIPE_PREFIX "shred: ";
  //   (5) walk target to compute length, emit target bytes;
  //   (6) emit WIPE_STUB_SUFFIX.
  //
  // Register plan (1-push prologue):
  //   rbx = target_ptr  (preserved across four Print::print_str calls)
  //   rdx = NUL-walk cursor
  //   rax = flag load / counter update / byte load scratch
  //   rdi = print_str arg 1
  //   rsi = print_str arg 2
  //   r11 = lea scratch (every .rodata + .bss access)
  //
  // Prologue: push rbx (rsp%16: 8 → 0). Epilogue: pop rbx, ret.
  // ============================================================================
  pub let wipe_emit : (u64) -> () !{mem, sysreg} @{} =
    fn (target_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "rm.M2-004 wipe_emit. Sets was_wiped_flag = 1 (the M3-002 audit hook reads this after all positionals are processed and stamps it onto the RemoveRecord's was_wiped boolean field), bumps wipe_count, and emits the four-part shred line: (optional 'rm: ') + 'shred: ' + <target> + WIPE_STUB_SUFFIX (67B, names the exact substrate gap: immediate trash-unlink + best-effort byte overwrite). No real shred at M2 — the mutating PdxFS ops (sys_pdxfs_unlink for the trash-entry, sys_pdxfs_secdisc for the byte overwrite where the device supports it) are R42 substrate work not in-tree. 1-push prologue (rbx) preserves target_ptr across four nested Print::print_str calls and aligns rsp%16 to 0. rdx is the NUL-walk cursor for the target-length compute; the walk uses the xor-rax + mov_b idiom per the #1248 mitigation. All immediates in cmp are 0 or single-byte chars. Every .bss / .rodata access via lea r11, [rip + sym]. Return: pop rbx, ret — no return value (unit).",
      block: {
        push rbx;                              // rsp%16: 8 → 0
        mov rbx, rdi;                          // rbx = target_ptr

        // (1) set was_wiped_flag = 1.
        mov rax, 1;
        lea r11, [rip + was_wiped_flag];
        mov [r11], rax;

        // (2) bump wipe_count.
        lea r11, [rip + wipe_count];
        mov rax, [r11];
        add rax, 1;
        mov [r11], rax;

        // (3) optional "rm: " prefix.
        lea r11, [rip + RmFlags::flag_v];
        mov rax, [r11];
        cmp rax, 0;
        je wipe_skip_verbose;

        lea rdi, [rip + VERBOSE_PREFIX];
        mov rsi, 4;                            // VERBOSE_PREFIX_LEN
        call Print::print_str;

      wipe_skip_verbose:
        // (4) "shred: " prefix (always).
        lea rdi, [rip + WIPE_PREFIX];
        mov rsi, 7;                            // WIPE_PREFIX_LEN
        call Print::print_str;

        // (5) walk target for length, print bytes.
        mov rdx, rbx;

      wipe_walk_target:
        xor rax, rax;
        mov_b rax, [rdx];
        cmp rax, 0;
        je wipe_walk_done;
        add rdx, 1;
        jmp wipe_walk_target;

      wipe_walk_done:
        mov rdi, rbx;
        mov rsi, rdx;
        sub rsi, rbx;
        call Print::print_str;

        // (6) WIPE_STUB_SUFFIX.
        lea rdi, [rip + WIPE_STUB_SUFFIX];
        mov rsi, 67;                           // WIPE_STUB_SUFFIX_LEN
        call Print::print_str;

        // Epilogue.
        pop rbx;
        ret
      }
    }
}
