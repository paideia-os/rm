// src/print.pdx — rm.M1-002
// Print helper: sys_write(fd, buf, len) wrapper for stdout and stderr.
//
// Scope
// -----
// M1 wraps paideia-os syscall #1 (sys_write) with a leaf function so
// rm's subcommand bodies do not have to open-code the syscall
// convention at every call site. Two entry points cover M1's needs:
//
//   print_str(buf_ptr, len)   — write to fd 1 (stdout)
//   print_err(buf_ptr, len)   — write to fd 2 (stderr)
//
// Both are thin: they set rdi=fd, keep rsi=buf_ptr and rdx=len from
// their caller, load rax=1 (SYSCALL_WRITE), and syscall. The paideia-os
// dispatch (src/kernel/core/syscall/dispatch.pdx L25) fast-paths fd 1
// and fd 2 to the UART driver, which is what M1 needs for a runnable
// rm before any real console driver arrives.
//
// M3 replaces the raw-text emission with libpdx-semantic-pipe records
// (RemoveRecord[] over the pipe layer). The Print module survives —
// libpdx-semantic-pipe still calls into print_str for its text
// fallback on --no-schema — but rm_remove_body's stdout emission
// switches to a schema builder instead.
//
// paideia-as compliance
// ---------------------
//   - Module Print (PascalCase basename).
//   - No test mnemonic; no zero-check needed here (both entry points
//     are leaf; the caller's len == 0 is a legal (no-op) syscall).
//   - r11 is scratch; unused in either entry point but still not
//     assumed live across calls (both leaves are single-syscall).
//   - Leaf functions: no callee-save touched, no push/pop parity to
//     preserve, rsp % 16 == 8 on entry stays 8 through the syscall
//     which the kernel treats correctly.
//
// This module is a per-repo copy of pkg/src/print.pdx by design: the
// R49/R50 wave has not yet promoted print-helpers into a shared
// library (that is scheduled for the pdx-help / libpaideia-io wave at
// R51+ per design/tooling/plan.md §5). Every tool ships its own copy
// through M4; the pattern is identical across pkg, rm, mkdir, cat.

module Print = structure {

  // -- Syscall number for sys_write in paideia-os. --
  // Mirrors the dispatch table at src/kernel/core/syscall/dispatch.pdx
  // (paideia-os): id 1 (write) with fd 1,2 fast-pathed to UART.
  pub let SYSCALL_WRITE : u64 = 1

  // File descriptors. paideia-os init seeds fd 0 (stdin), fd 1 (stdout),
  // fd 2 (stderr) at first ring-3 entry (see enter_user.pdx §7 in
  // paideia-os). rm inherits these across sys_execve.
  pub let FD_STDOUT : u64 = 1
  pub let FD_STDERR : u64 = 2

  // ============================================================================
  // print_str(buf_ptr, len) -> bytes_written
  //
  // Signature: print_str : (u64, u64) -> u64 !{mem, sysreg} @{}
  // RDI (input): buf_ptr — VA of a byte buffer
  // RSI (input): len     — number of bytes to write (0 legal → no-op)
  // RAX (output): bytes_written from sys_write, or negative errno on fail
  //
  // Register plan (leaf; syscall is the only nested op):
  //   rax = syscall id / return value
  //   rdi = fd (set to FD_STDOUT before syscall; overwrites caller's buf_ptr)
  //   rsi = buf_ptr (from caller; shifted into position for syscall)
  //   rdx = len (from caller; shifted into position for syscall)
  //
  // The shift is: caller's ABI is (buf_ptr in rdi, len in rsi); the
  // syscall's ABI is (fd in rdi, buf_ptr in rsi, len in rdx). So we
  // mov rdx, rsi and mov rsi, rdi before setting rdi to the fd.
  // ============================================================================
  pub let print_str : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (buf_ptr: u64) (len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "rm.M1-002 print_str. Wraps paideia-os syscall #1 (sys_write) for fd 1 (stdout). The paideia-os dispatch fast-paths fd 1 and 2 to the UART driver (src/kernel/core/syscall/dispatch.pdx L25) which is enough for M1's first-runnable placeholder output. Register shift: caller-ABI (rdi=buf_ptr, rsi=len) → syscall-ABI (rdi=fd, rsi=buf_ptr, rdx=len). Order matters: mov rdx first (needs rsi's original value), then mov rsi (needs rdi's original), then mov rdi (which clobbers the original buf_ptr but we no longer need it). Return in rax verbatim from the syscall — the caller decides whether short write / negative errno matters. sysreg effect declared because syscall mutates rcx and r11 per the x86_64 SYSRET convention (kernel restores them before ring-3 resume, but they are architecturally clobbered from the caller's perspective).",
      block: {
        mov rdx, rsi;                       // syscall arg 3 = len
        mov rsi, rdi;                       // syscall arg 2 = buf_ptr
        mov rdi, 1;                         // syscall arg 1 = FD_STDOUT
        mov rax, 1;                         // SYSCALL_WRITE
        syscall;
        ret
      }
    }

  // ============================================================================
  // print_err(buf_ptr, len) -> bytes_written
  //
  // Identical to print_str except fd 2 (stderr). Kept separate rather
  // than parameterised on fd so call sites read as "print to stdout"
  // vs "print to stderr" without a magic-number argument at the call.
  //
  // Consumers: RmMain emits its "argv parse error" and "usage: rm
  // <path>..." diagnostics via this helper; RmRemove emits its M1
  // placeholder line via print_str (stdout) because the placeholder
  // is a user-facing informational message, not an error.
  // ============================================================================
  pub let print_err : (u64, u64) -> u64 !{mem, sysreg} @{} =
    fn (buf_ptr: u64) (len: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "rm.M1-002 print_err. Same wrapper as print_str but with rdi=2 (FD_STDERR). Kept as a separate entry point so `Print::print_err(...)` at a call site reads as an intent-carrying name rather than `Print::print_fd(2, ...)` with a magic number. sysreg effect for the same syscall-clobber reason as print_str.",
      block: {
        mov rdx, rsi;                       // syscall arg 3 = len
        mov rsi, rdi;                       // syscall arg 2 = buf_ptr
        mov rdi, 2;                         // syscall arg 1 = FD_STDERR
        mov rax, 1;                         // SYSCALL_WRITE
        syscall;
        ret
      }
    }
}
