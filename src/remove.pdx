// src/remove.pdx — rm.M5-001 (extends M3-004)
// RmRemove module: the rm removal body.
//
// Scope at M2-001 (this milestone)
// --------------------------------
// M2-001 lands the positional iteration + per-target dispatch. The M1
// body walked only pos_ptrs[0]; the M2 body iterates the full range
// ParsedArgs::pos_ptrs[0..pos_count]. For every target it dispatches:
//
//   * flag_r == 1 → RmWalk::walk_recursive(target)   [src/walk.pdx]
//   * flag_r == 0 → rm_process_one(target)           [this module]
//
// `rm_process_one` is the M1-003 single-target body, unchanged in
// substance — it prints the four-part placeholder line and returns
// EXIT_OK. Later M2 milestones grow it: M2-002 adds the -f confirm
// branch, M2-003 threads a retention-emit hop through RmRetention,
// M2-004 dispatches on flag_wipe to RmWipe. Every one of those is a
// body edit inside rm_process_one, not a change to rm_remove_body's
// signature or the loader's cap set.
//
// The M1_STUB_SUFFIX string is retained (renamed to M2_STUB_SUFFIX
// with an M2-accurate message) because the mutating PdxFS ops needed
// for a real trash-move (sys_pdxfs_txn_open / sys_pdxfs_unlink /
// sys_pdxfs_link / sys_pdxfs_txn_commit) are not in-tree — see the
// mv.M1-003 preamble in the mv repo for the same substrate note.
// KIND_PDXFS_FILE and KIND_PDXFS_TXN are query-only at HEAD
// (paideia-os src/kernel/core/cap/kind_pdxfs_file.pdx L94-99 +
// kind_pdxfs_txn.pdx L91-96); the M2 body faithfully emits the shape
// of the future substrate call without inventing an outcome it did
// not observe. That preserves the D3 audit-first invariant M3-002
// will formalise.
//
// Substrate note (why the M2 body still emits a stub message)
// -----------------------------------------------------------
// See design/architecture.md §8 for the substrate gap discussion.
// Summary: PdxFS v1's mutating dispatch ops (unlink, rename, move,
// txn open/commit) are R42 substrate work that has not landed. rm.M2
// wires every M2-scope shape (positional iteration, recursive walk,
// -f confirm skip, retention-metadata attach, --wipe shred) up to but
// not including that boundary, and returns EXIT_OK from every leaf.
// When the substrate lands, every stub tail becomes a real syscall
// dispatch inside rm_process_one / walk_recursive / wipe_emit /
// retention_emit — no signature changes, no caps.decl churn.
//
// paideia-as compliance
// ---------------------
//   - Module RmRemove (PascalCase basename).
//   - No test mnemonic; every zero-check via cmp reg, 0.
//   - Every cmp reg, imm ≤ 0x7FFFFFFF (only 0, single-byte chars, and
//     the pos_count bound of 32 appear in immediates here; the 24h
//     retention constant is staged in r11 inside RmRetention, not here).
//   - r11 is scratch (used for every lea and every imm64 stage).
//   - Byte reads use xor rax, rax; mov_b rax, [ptr] per the #1248
//     mitigation.
//   - rm_remove_body prologue: 2-push (r12, r13) + sub rsp, 8 pad =
//     24 bytes. Entry rsp % 16 == 8, so 8 - 24 % 16 == 0. Post-
//     prologue rsp % 16 == 0 for every nested call site.
//   - rm_process_one prologue: 1-push (rbx). Entry rsp % 16 == 8;
//     push brings it to 0. Same shape as the M1-003 body.

module Remove = structure {

  // -- Exit codes shared with RmMain -----------------------------------
  pub let EXIT_OK             : u64 = 0
  pub let EXIT_OP_FAIL        : u64 = 1
  pub let EXIT_USAGE          : u64 = 2
  pub let EXIT_NOT_YET_IMPL   : u64 = 3

  // rm.ENH-004 (rm#21) SECURITY fix: EACCES-equivalent exit code. A
  // blocked-by-elevate removal used to fall through the loop and
  // return EXIT_OK (0) unconditionally -- fail-OPEN reporting: a
  // caller (or a script checking $?) had no signal that anything was
  // refused. rm_remove_body now checks the two block counters
  // (rm_blocked_by_elevate + walk_blocked_by_elevate) after the loop
  // and returns EXIT_EACCES (13, matching POSIX EACCES) whenever
  // either is non-zero for this invocation.
  pub let EXIT_EACCES         : u64 = 13

  // rm.ENH-004 (rm#21) diagnostic emitted on stderr at every block
  // site (resolve-fail, recursive-blocked, non-recursive-blocked)
  // inside rm_remove_body's loop. 28 bytes.
  pub let ENH004_BLOCKED_MSG     : [u8; 28] = "[rm.ENH-004 EACCES blocked]\n"
  pub let ENH004_BLOCKED_MSG_LEN : u64      = 28

  // -- Per-invocation counter ------------------------------------------
  // Bumped by rm_process_one on every entry (one bump per positional
  // target processed by the non-recursive branch). Reset each rm
  // invocation via remove_reset. M4's test harness reads this via
  // rm's smoke matrix.
  pub let mut removed_count : u64 = uninit @align(8)

  // -- M2-002 counters --------------------------------------------------
  // confirm_check bumps exactly one of these per call. Their sum equals
  // the number of confirm_check invocations, which equals the number
  // of rm_process_one entries (walk_recursive does not consult these
  // — a recursive walk skips confirmation entirely under -r's semantic,
  // documented in design/argv-surface.md §3.1). M3 replaces the
  // counter-only observability here with an interactive prompt once
  // rm has a stdin binding.
  //
  //   confirm_skips_by_f  — bumped when flag_f == 1 (skip granted).
  //   confirm_prompts_stub — bumped when flag_f == 0 (would prompt).
  pub let mut confirm_skips_by_f   : u64 = uninit @align(8)
  pub let mut confirm_prompts_stub : u64 = uninit @align(8)

  // -- M3-004 counter ---------------------------------------------------
  // rm_blocked_by_elevate — bumped when RmElevate::elevate_check_and_
  // request returns RE_BLOCKED (elevate needed AND libpdx-elevate
  // refused). The removal is skipped entirely — no confirm hop, no
  // print, no retention, no M3 emit hooks — but the process exit code
  // stays EXIT_OK (M4 raises this to EXIT_OP_FAIL when a smoke matrix
  // guarantees the broker is present; M3 preserves the substrate-
  // skeleton discipline where a HEAD run with no live broker still
  // completes cleanly). Reset each rm invocation via remove_reset.
  //
  // ENH-002 (#19) note: rm_blocked_by_elevate is ALSO bumped in
  // rm_remove_body when RmResolve::resolve_target returns 0 (empty
  // argv, sys_getcwd < 0, join overflow). Design/enhancement-plan.md
  // §3 groups resolve-fail with elevate-fail as "target refused
  // before dispatch"; the counter's semantics widen accordingly.
  pub let mut rm_blocked_by_elevate : u64 = uninit @align(8)

  // -- v1.2.0 real-body observability (#32) -----------------------------
  //
  // rm_real_unlink_ok  -- bumped on a successful pdxfs_unlink return
  //                        (rax == 0) from rm_process_one's default
  //                        (non-wipe, non-dry-run) path. Also bumped
  //                        from RmWipe::wipe_emit and
  //                        RmWalk::walk_recursive after their own real
  //                        syscall returns 0.
  // rm_real_unlink_err -- bumped when pdxfs_unlink returns non-zero.
  //                        A negative-errno u64 (rax >= 0x8000...) is
  //                        counted here; the specific errno is not
  //                        recorded per-slot (that lands with the M4
  //                        smoke's per-scenario expected-errno list).
  //
  // Both reset per invocation via remove_reset. The sum
  // (ok + err) equals the number of real-unlink call sites reached
  // (removed_count minus dry_run_count minus blocked_count).
  pub let mut rm_real_unlink_ok  : u64 = uninit @align(8)
  pub let mut rm_real_unlink_err : u64 = uninit @align(8)

  // -- M2 output message pieces ----------------------------------------
  // The M1-003 four-part shape is preserved: (optional verbose prefix)
  // + (optional dry-run prefix) + <target> + trailing suffix. The
  // trailing suffix at M2 names the M2 stub scope so a user reading
  // stdout under an M2 build sees where the real work is scheduled.

  // "rm: " — printed when RmFlags::flag_v == 1, before any other
  // prefix. Four bytes: 'r' 'm' ':' ' '.
  pub let VERBOSE_PREFIX     : [u8; 4]   = "rm: "
  pub let VERBOSE_PREFIX_LEN : u64       = 4

  // "would remove: " — printed when RmFlags::flag_dry_run == 1,
  // after any verbose prefix but before the target bytes. 14 bytes.
  pub let DRY_RUN_PREFIX     : [u8; 14]  = "would remove: "
  pub let DRY_RUN_PREFIX_LEN : u64       = 14

  // "\n" — the trailing byte when flag_dry_run is set.
  pub let NEWLINE            : [u8; 1]   = "\n"
  pub let NEWLINE_LEN        : u64       = 1

  // M2-scope stub suffix. Emitted from rm_process_one when
  // flag_dry_run == 0 (the default) AND flag_v == 0. Names the M2
  // substrate gap so a user reading stdout sees exactly which kernel
  // op is still missing. The leading ':' is deliberate under -v == 0:
  // Part 3 leaves the target line open (no terminator) so this suffix
  // continues it in one line: "<target>: (M2 stub ...)".
  pub let M2_STUB_SUFFIX     : [u8; 61]  =
    ": (M2 stub -- real trash-move lands with PdxFS mutating ops)\n"
  pub let M2_STUB_SUFFIX_LEN : u64       = 61

  // rm.ENH-006 (issue #23): verbose variant of M2_STUB_SUFFIX. Under
  // -v, Part 3 now closes the "rm: <target>" line with its own
  // newline (so retention_attach's note prints as a second complete
  // "rm: ..." line rather than fusing into an open one — see the
  // interleaving bug this issue fixes). This suffix must therefore
  // stand as its own complete line too, so it gets its own "rm: "
  // prefix instead of the bare leading ':' the non-verbose form uses.
  // 63 bytes.
  pub let M2_STUB_SUFFIX_VERBOSE     : [u8; 63]  =
    "rm: (M2 stub -- real trash-move lands with PdxFS mutating ops)\n"
  pub let M2_STUB_SUFFIX_VERBOSE_LEN : u64       = 63

  // M2-002: emitted from confirm_check when flag_v == 1 AND flag_f == 1.
  // 26 bytes: "-f: skipping confirmation\n".
  pub let F_SKIP_NOTE       : [u8; 26]  = "-f: skipping confirmation\n"
  pub let F_SKIP_NOTE_LEN   : u64       = 26

  // M2-002: emitted from confirm_check when flag_v == 1 AND flag_f == 0.
  // 40 bytes: "would prompt for confirmation (M2 stub)\n".
  pub let PROMPT_STUB_NOTE     : [u8; 40] =
    "would prompt for confirmation (M2 stub)\n"
  pub let PROMPT_STUB_NOTE_LEN : u64      = 40

  // ============================================================================
  // remove_reset()
  //
  // Signature: remove_reset : () -> () !{mem, sysreg} @{cap}
  //
  // At M3-001 this widened from a pure .bss zeroer (M1/M2) to a compound
  // reset that also delegates to RmSchema::schema_reset. M3-002/003/004
  // extended the delegation list (audit_reset, undo_reset, elevate_reset).
  //
  // At M5-001 the umbrella closes the reset-list gap that the M4 tests
  // flagged (tests/m4_001_txn_abort.pdx L57-64 + src/walk.pdx L98-105 +
  // src/retention.pdx §retention_attach). Four .bss slots that a prior
  // rm invocation could leave non-zero are added here so a re-entered
  // process (M5 substrate lands a real umbrella loop) starts every run
  // baseline:
  //
  //   * RmRetention::retention_attach_count  — bumped per non-wipe /
  //     non-dry-run rm_process_one; a stale value would let a downstream
  //     "did retention fire?" assertion misfire.
  //   * RmRetention::retention_deadline_ns   — snapshot of the last
  //     computed 24h deadline; RmUndo::undo_write reads it into the
  //     6-lane undo record's retention lane. A stale value would carry
  //     a previous invocation's deadline into a fresh undo record.
  //   * RmWalk::walk_invocations             — bumped per walk_recursive
  //     entry; M4 smoke reads removed_count + walk_invocations as an
  //     accounting invariant (sum == pos_count).
  //   * RmWalk::walk_blocked_by_elevate      — bumped when the walk
  //     branch's top-level target is refused by libpdx-elevate; a stale
  //     value would let an operator misread a fresh refusal.
  //
  // Adding these here also lets tests/m4_001_txn_abort.pdx L133-137
  // drop its manual zeroing (retained as defensive idempotent lines
  // until an M5 substrate PR moves them out).
  //
  // Prologue: sub rsp, 8 pad (entry rsp%16 == 8 → post-sub 0) for the
  // four nested M3 resets. Matched add rsp, 8 before ret. r11 scratch
  // for every .bss write. All immediates 0.
  // ============================================================================
  pub let remove_reset : () -> () !{mem, sysreg} @{cap, sched} =
    fn () -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap, sched},
      justification: "rm v1.2.0 remove_reset (widens M5-001 with resolve_reset for #19). Zero the M1/M2 slots (removed_count, confirm_skips_by_f, confirm_prompts_stub, RmWipe::was_wiped_flag, RmWipe::wipe_count) AND the M3-004 rm_blocked_by_elevate counter AND the four M5-001 slots that close the M4-001 reset-list gap (RmRetention::retention_attach_count, RmRetention::retention_deadline_ns, RmWalk::walk_invocations, RmWalk::walk_blocked_by_elevate), then delegate to each M3+ module reset (RmSchema::schema_reset, RmAudit::audit_reset, RmUndo::undo_reset, RmElevate::elevate_reset, RmResolve::resolve_reset -- new at v1.2.0). Prologue: sub rsp, 8 pad; entry rsp%16 == 8 -> post-sub rsp%16 == 0 for the five nested calls. r11 scratch for every .bss write; each lea writes to its slot before the next lea replaces r11 (no overlap). All immediates 0.",
      block: {
        sub rsp, 8;                                 // rsp%16: 8 -> 0

        xor rax, rax;
        lea r11, [rip + removed_count];             mov [r11], rax;
        lea r11, [rip + confirm_skips_by_f];        mov [r11], rax;
        lea r11, [rip + confirm_prompts_stub];      mov [r11], rax;
        lea r11, [rip + rm_blocked_by_elevate];     mov [r11], rax;
        lea r11, [rip + was_wiped_flag];    mov [r11], rax;
        lea r11, [rip + wipe_count];        mov [r11], rax;

        lea r11, [rip + retention_attach_count];    mov [r11], rax;
        lea r11, [rip + retention_deadline_ns];     mov [r11], rax;
        lea r11, [rip + walk_invocations];          mov [r11], rax;
        lea r11, [rip + walk_blocked_by_elevate];   mov [r11], rax;

        // v1.2.0 real-body observability (#32).
        lea r11, [rip + rm_real_unlink_ok];         mov [r11], rax;
        lea r11, [rip + rm_real_unlink_err];        mov [r11], rax;

        // Delegate to module resets (M3-001..004 + v1.2.0 resolve +
        // rm.LE-002/#30 rm_r_cap).
        call schema_reset;
        call audit_reset;
        call undo_reset;
        call elevate_reset;
        call resolve_reset;
        call rm_r_cap_reset;

        add rsp, 8;
        ret;
      }
    }

  // ============================================================================
  // confirm_check(target_ptr) -> ()
  //
  // Signature: confirm_check : (u64) -> () !{mem, sysreg} @{}
  // RDI (input): target_ptr — pointer to the target path (currently
  //              unused by the M2 body; the M3 interactive-prompt
  //              upgrade will use it to name the target in the prompt
  //              line, which is why the signature carries it forward).
  //
  // M2-002 body: read flag_f; bump exactly one of the two counters
  // (confirm_skips_by_f when flag_f == 1, confirm_prompts_stub
  // otherwise). If flag_v == 1 additionally emit a one-line note
  // (F_SKIP_NOTE or PROMPT_STUB_NOTE) via Print::print_str.
  //
  // At M2 the return is unit — every call path proceeds with the
  // removal (there is no real prompt to decline). At M3 the return
  // becomes a bool (proceed / abort); the caller in rm_process_one
  // gains a branch on that return. The M2 → M3 upgrade is a body
  // edit inside this helper + a two-line branch in rm_process_one;
  // the signature stays (u64) -> u64 at M3 (returning 0 = proceed,
  // 1 = abort).
  //
  // Register plan (leaf; no callee-save needed, one nested Print call):
  //   sub rsp, 8   — align rsp%16 to 0 for the nested Print::print_str
  //   rdi = print_str arg 1 (buffer pointer, overwrites caller's target)
  //   rsi = print_str arg 2 (length)
  //   rax = flag load / counter update scratch
  //   r11 = lea scratch (every .bss access via lea r11, [rip + sym])
  // ============================================================================
  pub let confirm_check : (u64) -> () !{mem, sysreg} @{} =
    fn (target_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "rm.M2-002 confirm_check. Reads flag_f + flag_v; bumps exactly one of confirm_skips_by_f / confirm_prompts_stub per call and optionally emits a one-line stub note via Print::print_str. No real prompt is issued at M2 (rm has no stdin binding yet; the interactive prompt lands at M3 alongside the shell.M3 stdin plumbing). target_ptr is preserved-by-not-touching-callee-save — the M2 body needs it only for the M3 upgrade path where the prompt line names the target; at M2 the arg is present-but-unused (documented in the signature block above). Prologue: sub rsp, 8 = 8 bytes; entry rsp % 16 == 8, so 8 + 8 % 16 == 0. Post-prologue rsp % 16 == 0 for the nested Print::print_str call site. Matched add rsp, 8 in each return path. All immediates in cmp are 0 (paideia-as no-test-mnemonic + imm32 discipline). Every .bss access via lea r11, [rip + sym].",
      block: {
        sub rsp, 8;                            // rsp%16: 8 → 0

        // Branch on flag_f.
        lea r11, [rip + flag_f];
        mov rax, [r11];
        cmp rax, 0;
        jne confirm_f_active;

        // ---- flag_f == 0: would-prompt branch ---------------------------
        lea r11, [rip + confirm_prompts_stub];
        mov rax, [r11];
        add rax, 1;
        mov [r11], rax;

        // Emit note only under -v.
        lea r11, [rip + flag_v];
        mov rax, [r11];
        cmp rax, 0;
        je confirm_done;

        lea rdi, [rip + PROMPT_STUB_NOTE];
        mov rsi, 40;                           // PROMPT_STUB_NOTE_LEN
        call print_str;
        jmp confirm_done;

      confirm_f_active:
        // ---- flag_f == 1: skip-granted branch ---------------------------
        lea r11, [rip + confirm_skips_by_f];
        mov rax, [r11];
        add rax, 1;
        mov [r11], rax;

        lea r11, [rip + flag_v];
        mov rax, [r11];
        cmp rax, 0;
        je confirm_done;

        lea rdi, [rip + F_SKIP_NOTE];
        mov rsi, 26;                           // F_SKIP_NOTE_LEN
        call print_str;
        // fallthrough

      confirm_done:
        add rsp, 8;
        ret;
      }
    }

  // ============================================================================
  // rm_remove_body(target_ptr) -> exit_code
  //
  // Signature: rm_remove_body : (u64) -> u64 !{mem, sysreg} @{}
  // RDI (input): target_ptr — the M1-era first-positional pointer,
  //              retained for signature compatibility with RmMain::
  //              rm_main. At M2 this argument is IGNORED; the body
  //              iterates ParsedArgs::pos_ptrs[0..pos_count] directly
  //              so every positional is dispatched.
  // RAX (output): 0 (EXIT_OK) on a clean run; 13 (EXIT_EACCES,
  //               rm.ENH-004 / rm#21 SECURITY fix) iff any positional
  //               this invocation processed was refused before
  //               dispatch (resolve-fail or elevate-block). Prior to
  //               ENH-004 every path returned EXIT_OK unconditionally
  //               — a blocked removal reported success (fail-OPEN).
  //               Substrate-real per-target error codes (EXIT_OP_FAIL)
  //               become reachable when the PdxFS mutating ops land.
  //
  // Iteration: for i in 0..pos_count:
  //   target = pos_ptrs[i]
  //   if flag_r == 1: walk_recursive(target)
  //   else:           rm_process_one(target)
  //
  // Register plan (2-push + 8-byte pad):
  //   r12 = i           (loop counter; preserved across dispatch call)
  //   r13 = pos_count   (loaded once at loop entry; preserved)
  //   [rsp+0] = pad     (keeps rsp%16 == 0 at every nested call site)
  //   rdi = dispatch arg (pos_ptrs[i] before every call)
  //   rax = flag load / call return scratch
  //   r11 = lea scratch (all .bss reads via lea r11, [rip + sym])
  //
  // Prologue arithmetic (entry rsp % 16 == 8):
  //   push r12    → rsp%16: 8 → 0
  //   push r13    → rsp%16: 0 → 8
  //   sub rsp, 8  → rsp%16: 8 → 0   ← every nested call site aligned
  // Matched epilogue reverses.
  // ============================================================================
  pub let rm_remove_body : (u64) -> u64 !{mem, sysreg} @{} =
    fn (target_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {},
      justification: "rm v1.2.0 rm_remove_body (extends ENH-001/#18 with #19 resolve-then-gate). Iterates ParsedArgs::pos_ptrs[0..pos_count]. For every positional: (1) RmResolve::resolve_target absolutises the argv-ptr via sys_getcwd + join (returns 0 on empty/getcwd-fail/join-overflow); (2) RmElevate::elevate_check_and_request runs the /system/ prefix scan on the RESOLVED path (closes #19 -- gate no longer sees raw argv bytes); (3) dispatch on flag_r to walk_recursive or rm_process_one, passing the resolved pointer as target_ptr. Resolve fail (rax==0) is treated as a blocked target (bumps rm_blocked_by_elevate; skips dispatch). Elevate refusal (rax!=0) skips dispatch and bumps the counter matching the flag_r arm (walk_blocked_by_elevate for flag_r==1, rm_blocked_by_elevate otherwise). 3-push prologue (r12=i, r13=pos_count, r14=resolved_ptr) leaves rsp%16 == 0 at every nested call site (resolve_target, elevate_check_and_request, walk_recursive, rm_process_one -- entry %16==8, 3 pushes -> 0). All five SysV callee-save regs preserved across each call by the SysV contract. r14 holds the resolved pointer across the elevate call so dispatch does not need a second read from rm_resolved_ptr .bss. All immediates in cmp are 0 or the pos_count bound (32). Every .bss read via lea r11, [rip + sym]. Return: pop r14/r13/r12, xor rax,rax, ret -- exit code always EXIT_OK at v1.2.0 (per-target pdxfs_unlink failures are counted in rm_process_one's own tail; the process exit stays EXIT_OK to preserve the v1.0/v1.1 shape until the R42 substrate lands full trash-move error propagation).",
      block: {
        // Prologue: preserve iteration state + resolved pointer; align for nested calls.
        push r12;                              // rsp%16: 8 -> 0
        push r13;                              // rsp%16: 0 -> 8
        push r14;                              // rsp%16: 8 -> 0

        // Initialise loop counter and bound.
        xor r12, r12;                          // i = 0
        lea r11, [rip + pos_count];
        mov r13, [r11];                        // r13 = pos_count

      rm_remove_loop_head:
        // Terminate when i >= pos_count.
        cmp r12, r13;
        jge rm_remove_loop_done;

        // Load pos_ptrs[i] into rdi (resolve arg).
        lea r11, [rip + pos_ptrs];
        mov rdi, [r11 + r12*8];

        // ---- SECURITY (#19): resolve argv to absolute path FIRST. --
        call resolve_target;                   // rax = resolved_ptr (0 on fail)
        cmp rax, 0;
        je  rm_remove_resolve_fail;
        mov r14, rax;                          // r14 = resolved_ptr

        // ---- SECURITY (#18/#19): elevate gate on RESOLVED path. ----
        mov rdi, r14;
        call elevate_check_and_request;
        cmp rax, 0;                            // RE_PROCEED (0)
        jne rm_remove_blocked;

        // Dispatch on flag_r. Pass resolved pointer as target_ptr.
        lea r11, [rip + flag_r];
        mov rax, [r11];
        cmp rax, 0;
        je rm_remove_call_process_one;

        // Recursive branch: rm.LE-002 (rm#30) routes through RmRCap::
        // rm_r_cap_wrap(resolved), which derives a per-directory
        // sub-cap (ElevateClient::elevate_client_cap_derive) around
        // the RmWalk::walk_recursive call and tears the whole derived
        // sub-tree down (elevate_client_cap_revoke_cascade) once the
        // walk returns -- see src/rm_r_cap.pdx.
        mov rdi, r14;
        call rm_r_cap_wrap;
        jmp rm_remove_loop_advance;

      rm_remove_call_process_one:
        // Non-recursive branch: rm_process_one(resolved).
        mov rdi, r14;
        call rm_process_one;
        jmp rm_remove_loop_advance;

      rm_remove_resolve_fail:
        // Resolve failed (empty argv, getcwd < 0, join overflow).
        // Treat as blocked; bump rm_blocked_by_elevate as the closest
        // observability slot (design/enhancement-plan.md §3 groups
        // resolve-fail with elevate-fail as "target refused before
        // dispatch").
        lea r11, [rip + rm_blocked_by_elevate];
        mov rax, [r11];
        add rax, 1;
        mov [r11], rax;
        lea rdi, [rip + ENH004_BLOCKED_MSG];
        mov rsi, 28;                           // ENH004_BLOCKED_MSG_LEN
        call print_err;
        jmp rm_remove_loop_advance;

      rm_remove_blocked:
        // Elevate refused: skip dispatch entirely. Bump the counter that
        // matches the arm this target would have taken.
        lea r11, [rip + flag_r];
        mov rax, [r11];
        cmp rax, 0;
        je rm_remove_blocked_nonrecursive;

        lea r11, [rip + walk_blocked_by_elevate];
        mov rax, [r11];
        add rax, 1;
        mov [r11], rax;
        lea rdi, [rip + ENH004_BLOCKED_MSG];
        mov rsi, 28;                           // ENH004_BLOCKED_MSG_LEN
        call print_err;
        jmp rm_remove_loop_advance;

      rm_remove_blocked_nonrecursive:
        lea r11, [rip + rm_blocked_by_elevate];
        mov rax, [r11];
        add rax, 1;
        mov [r11], rax;
        lea rdi, [rip + ENH004_BLOCKED_MSG];
        mov rsi, 28;                           // ENH004_BLOCKED_MSG_LEN
        call print_err;

      rm_remove_loop_advance:
        add r12, 1;
        jmp rm_remove_loop_head;

      rm_remove_loop_done:
        // rm.ENH-004 (rm#21) SECURITY fix: fail-closed exit code. If
        // ANY target this invocation processed was refused before
        // dispatch (resolve-fail or elevate-block, either dispatch
        // arm), return EXIT_EACCES instead of the pre-fix EXIT_OK.
        // No `add reg, [mem]` (encoder discipline) -- both counters
        // are loaded into registers before being summed.
        lea r11, [rip + rm_blocked_by_elevate];
        mov rax, [r11];
        lea r11, [rip + walk_blocked_by_elevate];
        mov r10, [r11];
        add rax, r10;
        cmp rax, 0;
        jne rm_remove_loop_blocked;

        // Epilogue: restore stack, return EXIT_OK.
        pop r14;
        pop r13;
        pop r12;
        xor rax, rax;                          // EXIT_OK
        ret;

      rm_remove_loop_blocked:
        pop r14;
        pop r13;
        pop r12;
        mov rax, 13;                           // EXIT_EACCES
        ret;
      }
    }

  // ============================================================================
  // rm_process_one(target_ptr) -> exit_code
  //
  // Signature: rm_process_one : (u64) -> u64 !{mem, sysreg} @{}
  // RDI (input): target_ptr — VA of a NUL-terminated path (from
  //                            ParsedArgs::pos_ptrs[i])
  // RAX (output): 0 (EXIT_OK) — M2 body always succeeds against the
  //               stub substrate.
  //
  // Body: honour flag_v + flag_dry_run + print the four-part
  // placeholder line, then bump removed_count and return EXIT_OK.
  //
  // Register plan (1-push prologue for target preservation + align):
  //   rbx = target_ptr  (preserved across every nested Print call)
  //   rdx = NUL-walk cursor for target-length compute
  //   rax = byte-load / flag-load / syscall-return scratch
  //   rdi = print_str arg 1 (buffer pointer)
  //   rsi = print_str arg 2 (length)
  //   r11 = lea scratch (for .rodata strings and RmFlags .bss)
  //
  // Prologue: push rbx (rsp%16: 8 → 0). Epilogue: pop rbx, load rax=0,
  // ret (restores rsp%16 to 8 for the caller). Same shape as the
  // M1-003 body — the M2 restructure moved the iteration one level
  // up to rm_remove_body, but the per-target body itself is
  // structurally identical.
  //
  // M2-002/003/004 body edits (arriving in the sibling commits):
  //   M2-002 adds a flag_f branch that emits a "would confirm" note
  //          when flag_f == 0 (prompt is not yet interactive, so the
  //          note is stdout-only; -f causes it to be skipped).
  //   M2-003 threads a RmRetention::retention_emit_note call between
  //          the target-print and the M2-stub suffix so the trash
  //          entry's 24h retention deadline is surfaced per-target.
  //   M2-004 dispatches on flag_wipe: when set, RmWipe::wipe_emit +
  //          wipe_mark replace the retention emit + M2-stub suffix
  //          (a shred does not create a trash-subtree entry, so no
  //          retention applies; the audit flag is set for M3-002).
  //   ENH-001 (#18) removed the elevate check that used to run first
  //          in this body — it now runs once in RmRemove::rm_remove_
  //          body's loop, before dispatch, covering both the
  //          recursive and non-recursive arms.
  //   ENH-006 (#23) fixed a verbose-output interleaving bug: under -v
  //          this body now closes the "rm: <target>" line with a
  //          newline before calling retention_attach, whose note is
  //          now its own prefixed "rm: ..." line; the trailing M2
  //          stub suffix has a verbose variant (own "rm: ..." line)
  //          and the original non-verbose variant (colon-continuation
  //          of the still-open target line), selected on flag_v.
  // ============================================================================
  pub let rm_process_one : (u64) -> u64 !{mem, sysreg} @{cap, sched} =
    fn (target_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap, sched},
      justification: "rm.ENH-001 (issue #18) rm_process_one (extended through M3-003). Flow: (target_len) NUL-walk stashed in r12 up-front so every M3 hook has the length available. The elevate gate that used to run first in THIS function has moved to RmRemove::rm_remove_body's loop (single call site covering both the recursive and non-recursive dispatch arms — see #18); by the time rm_process_one is entered the target has already been cleared to proceed, so this body no longer calls elevate_check_and_request nor owns rm_blocked_by_elevate's bump. (M2-002) confirm_check bumps skip/prompt counters. Dispatch priority (design/argv-surface.md §3.2): dry-run > wipe > default. (M2-004) --wipe branch: RmWipe::wipe_emit handles the four-part shred line + audit-flag set + counter bump, then the M3 hooks fire (RmSchema::record_emit + RmAudit::audit_record_target — NO undo, wipe leaves no trash entry so no reversal exists; this is the load-bearing forensic-detection invariant from design/argv-surface.md §3.1). Default branch: Part 1 (verbose) + Part 2 (dry-run prefix) + Part 3 (target); Part 4 dispatches on dry-run — dry-run prints '\\n' with NO M3 hooks (dry-run is by design non-emitting; the M3 record set describes real removals only); default prints the four M3 hops (retention_attach + undo_write + record_emit + audit_record_target) + M2_STUB_SUFFIX. undo_write runs AFTER retention_attach because undo_write snapshots RmRetention::retention_deadline_ns which retention_attach populates. 2-push prologue (rbx=target_ptr, r12=target_len) + sub rsp, 8 pad = 24 bytes; entry rsp % 16 == 8 → 8 + 24 = 32 → 32 % 16 == 0 for every nested call site (confirm_check, wipe_emit, Print::print_str, retention_attach, undo_write, record_emit, audit_record_target). rbx + r12 preserved across every nested call by SysV callee-save. Every .bss / .rodata read via lea r11, [rip + sym]. Byte reads via xor rax, rax; mov_b rax, [ptr] (#1248 mitigation) in the NUL-walk. All immediates ≤ 63 fit imm32. Effect tail !{mem, sysreg} @{cap, sched} covers the audit + semantic-pipe call fanout. Return: undo pad, pop r12, pop rbx, xor rax,rax, ret — always EXIT_OK at M3.",
      block: {
        // Prologue: preserve target_ptr + target_len across every hook.
        push rbx;                              // rsp%16: 8 → 0
        push r12;                              // rsp%16: 0 → 8
        sub rsp, 8;                            // rsp%16: 8 → 0

        mov rbx, rdi;                          // rbx = target_ptr

        // ---- Compute target_len via NUL-walk (once, stashed in r12) ----
        // Every M3 hook needs the length available; a single up-front
        // compute is cheaper than a per-hook re-walk.
        mov rdx, rbx;                          // cursor = target_ptr

      rm_process_len_walk:
        xor rax, rax;
        mov_b rax, [rdx];
        cmp rax, 0;
        je rm_process_len_done;
        add rdx, 1;
        jmp rm_process_len_walk;

      rm_process_len_done:
        mov r12, rdx;
        sub r12, rbx;                          // r12 = target_len

        // ---- M2-002: confirm gate (proceeds unconditionally at M2/M3) ---
        mov rdi, rbx;                          // arg = target_ptr
        call confirm_check;

        // ---- M2-004: --wipe short-circuit -------------------------------
        // Priority: dry-run beats wipe beats default.
        lea r11, [rip + flag_dry_run];
        mov rax, [r11];
        cmp rax, 0;
        jne rm_process_part1;                  // dry-run beats wipe

        lea r11, [rip + flag_wipe];
        mov rax, [r11];
        cmp rax, 0;
        je rm_process_part1;                   // no wipe: default path

        // --wipe branch: shred emit, then M3 hooks.
        mov rdi, rbx;                          // arg = target_ptr
        call wipe_emit;

        // M3-001 record emit (wipe path).
        mov rdi, rbx;                          // target_ptr
        mov rsi, r12;                          // target_len
        xor rdx, rdx;                          // was_dir = 0 (M3 stub)
        xor rcx, rcx;                          // trash_handle = 0 (M3 stub)
        call record_emit;

        // M3-002 audit record (wipe path).
        mov rdi, rbx;
        call audit_record_target;

        jmp rm_process_done_ok;

      rm_process_part1:
        // ---- Part 1: optional "rm: " prefix (flag_v == 1) ---------------
        lea r11, [rip + flag_v];
        mov rax, [r11];
        cmp rax, 0;
        je rm_process_skip_verbose;

        lea rdi, [rip + VERBOSE_PREFIX];
        mov rsi, 4;                            // VERBOSE_PREFIX_LEN
        call print_str;

      rm_process_skip_verbose:
        // ---- Part 2: conditional "would remove: " (flag_dry_run == 1) ---
        lea r11, [rip + flag_dry_run];
        mov rax, [r11];
        cmp rax, 0;
        je rm_process_skip_dry_prefix;

        lea rdi, [rip + DRY_RUN_PREFIX];
        mov rsi, 14;                           // DRY_RUN_PREFIX_LEN
        call print_str;

      rm_process_skip_dry_prefix:
        // ---- Part 3: print the target string ----------------------------
        // r12 already holds target_len — no second walk needed.
        mov rdi, rbx;                          // buffer
        mov rsi, r12;                          // length
        call print_str;

        // ---- Part 4: trailing suffix (dry-run → '\n' with NO M3 hook;
        //              else → retention_attach + record_emit + M2 stub) -
        lea r11, [rip + flag_dry_run];
        mov rax, [r11];
        cmp rax, 0;
        je rm_process_print_m2_suffix;

        // Dry-run: just a newline. NO M3 hook — dry-run is by design
        // non-emitting; the M3 record set describes real removals only.
        lea rdi, [rip + NEWLINE];
        mov rsi, 1;                            // NEWLINE_LEN
        call print_str;
        jmp rm_process_done_ok;

      rm_process_print_m2_suffix:
        // ---- rm.ENH-006 (issue #23): close the "rm: <target>" line -----
        // before any interposed hook prints. Under -v, retention_attach
        // below emits its OWN complete "rm: trash retention: ..." line;
        // without this newline that note fused directly onto Part 3's
        // unterminated target bytes (the reported "rm: report.txttrash
        // retention: ..." garble). Under non-verbose, retention_attach
        // emits nothing, so the target line is deliberately left open
        // here — M2_STUB_SUFFIX's leading ':' closes it below in one
        // line, unchanged from the pre-fix behaviour.
        lea r11, [rip + flag_v];
        mov rax, [r11];
        cmp rax, 0;
        je rm_process_m2_suffix_retention;

        lea rdi, [rip + NEWLINE];
        mov rsi, 1;                            // NEWLINE_LEN
        call print_str;

      rm_process_m2_suffix_retention:
        // ---- M2-003: retention attach (populates retention_deadline_ns
        //              which RmUndo::undo_write snapshots below) -------
        mov rdi, rbx;                          // arg = target_ptr
        call retention_attach;

        // ---- M3-003: undo write (default path only — wipe leaves no
        //              trash entry so no undo record applies) ---------
        mov rdi, rbx;                          // target_ptr
        mov rsi, r12;                          // target_len
        xor rdx, rdx;                          // was_dir = 0 (M3 stub)
        xor rcx, rcx;                          // trash_handle = 0 (M3 stub)
        call undo_write;

        // ---- M3-001: record emit (default path) --------------------------
        mov rdi, rbx;
        mov rsi, r12;
        xor rdx, rdx;
        xor rcx, rcx;
        call record_emit;

        // ---- M3-002: audit record (default path) -------------------------
        mov rdi, rbx;
        call audit_record_target;

        // ---- M2 stub suffix (visual: names the substrate gap). Verbose
        //      gets its own complete "rm: ..." line (Part 3's target
        //      line and retention's note line are already closed above);
        //      non-verbose keeps the colon-continuation form that closes
        //      Part 3's still-open target line in a single line. -------
        lea r11, [rip + flag_v];
        mov rax, [r11];
        cmp rax, 0;
        je rm_process_m2_suffix_plain;

        lea rdi, [rip + M2_STUB_SUFFIX_VERBOSE];
        mov rsi, 63;                           // M2_STUB_SUFFIX_VERBOSE_LEN
        jmp rm_process_m2_suffix_print;

      rm_process_m2_suffix_plain:
        lea rdi, [rip + M2_STUB_SUFFIX];
        mov rsi, 61;                           // M2_STUB_SUFFIX_LEN

      rm_process_m2_suffix_print:
        call print_str;

        // ---- v1.2.0 (#32) real-body: pdxfs_unlink on resolved path ----
        // Only the default (non-wipe, non-dry-run) path reaches here.
        // Wipe path jumps to rm_process_done_ok BEFORE M2 suffix and
        // has its own pdxfs_unlink inside wipe_emit. Dry-run also
        // bypasses this by jumping to done_ok before the M2 suffix.
        //
        // Args: rdi = rbx (resolved target_ptr), rsi = r12 (target_len).
        // Return: 0 on success, negative-errno u64 on failure. The
        // ok/err counters are the observability signal; the process
        // exit stays EXIT_OK (v1.0/v1.1 shape preserved until the R42
        // substrate lands full trash-move error propagation).
        mov rdi, rbx;
        mov rsi, r12;
        call pdxfs_unlink;
        cmp rax, 0;
        jne rm_process_unlink_err;
        lea r11, [rip + rm_real_unlink_ok];
        mov rax, [r11];
        add rax, 1;
        mov [r11], rax;
        jmp rm_process_done_ok;

      rm_process_unlink_err:
        lea r11, [rip + rm_real_unlink_err];
        mov rax, [r11];
        add rax, 1;
        mov [r11], rax;
        // fallthrough

      rm_process_done_ok:
        // Bump per-target counter; M4 smoke reads this back.
        lea r11, [rip + removed_count];
        mov rax, [r11];
        add rax, 1;
        mov [r11], rax;

        // Epilogue.
        add rsp, 8;                            // undo pad
        pop r12;
        pop rbx;
        xor rax, rax;                          // EXIT_OK
        ret;
      }
    }
}
